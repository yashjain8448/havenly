<%- include('../partials/head') %>
</head>

<body class="bg-gradient-to-b from-red-500 via-orange-50 to-yellow-50 min-h-screen">
  <%- include('../partials/nav') %>

  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-red-500 to-orange-500 text-white py-12 px-4">
    <div class="container mx-auto text-center">
      <h1 class="text-4xl font-bold drop-shadow-lg">🏠 <%= home.houseName %></h1>
      <p class="text-red-100 mt-2">Discover all the details</p>
    </div>
  </div>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-12 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      
      <!-- Image Section -->
      <div class="rounded-xl overflow-hidden shadow-xl">
        <img
          src="<%= home.homeImage %>"
          alt="<%= home.houseName %>"
          class="w-full h-96 object-cover group-hover:scale-110 transition duration-300"
        />
      </div>

      <!-- Details Section -->
      <div class="space-y-6">
        
        <!-- Location -->
        <div class="bg-white rounded-xl p-6 shadow-md border-l-4 border-red-500">
          <h3 class="text-lg font-semibold text-gray-800 mb-2 flex items-center">
            <svg class="w-5 h-5 text-red-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/>
            </svg>
            Location
          </h3>
          <p class="text-gray-700 text-lg font-medium"><%= home.location %></p>
        </div>

        <!-- Price -->
        <div class="bg-white rounded-xl p-6 shadow-md border-l-4 border-green-500">
          <h3 class="text-lg font-semibold text-gray-800 mb-2 flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6z"/>
            </svg>
            Price Per Night
          </h3>
          <p class="text-green-600 text-3xl font-bold">Rs <%= home.price %></p>
        </div>

        <!-- Rating -->
        <div class="bg-white rounded-xl p-6 shadow-md border-l-4 border-yellow-500">
          <h3 class="text-lg font-semibold text-gray-800 mb-2 flex items-center">
            <svg class="w-5 h-5 text-yellow-400 fill-current mr-2" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            Rating
          </h3>
          <p class="text-gray-700 text-xl font-medium"><%= home.rating %> / 5 ⭐</p>
        </div>

            <!-- Download Brochure -->
      <div class="bg-white rounded-xl p-6 shadow-md mt-10 border-l-4 border-blue-500">

        <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
          <svg class="w-5 h-5 text-blue-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M5 20h14v-2H5v2zm7-18l-5 5h3v6h4V7h3l-5-5z"/>
          </svg>
          Brochure
        </h3>

        <a 
          href="<%= home.homeBrochurePath %>?fl_attachment=true"
          class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg shadow hover:bg-blue-700 transition font-medium"
          target="_blank"
        >
          📥 Download Brochure
        </a>

      </div>


        <!-- Favourite Button -->
        <div class="bg-white rounded-xl p-6 shadow-md">
          <%- include('../partials/favourites') %>
        </div>
      </div>
    </div>

    <!-- Description Section -->
    <div class="bg-white rounded-xl p-8 shadow-md mt-10">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">About This Home</h2>
      <p class="text-gray-700 leading-relaxed text-lg"><%= home.description %></p>
    </div>
  </main>
</body>
</html>
