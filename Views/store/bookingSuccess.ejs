<%- include('../partials/head') %>
</head>

<body class="bg-gradient-to-b from-red-500 via-orange-50 to-yellow-50 min-h-screen">
  <%- include('../partials/nav') %>

  <!-- Hero -->
  <div class="bg-gradient-to-b from-red-500 to-orange-500 text-white py-12 px-4">
    <div class="container mx-auto text-center">
      <h1 class="text-4xl font-bold drop-shadow-lg">Booking Successful 🎉</h1>
      <p class="text-lg text-red-100 mt-2">Your haven has been reserved!</p>
    </div>
  </div>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-12 max-w-2xl">

    <!-- Success Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 max-w-xl mx-auto mt-12 text-center">

        <!-- Icon -->
        <div class="mx-auto mb-6 flex items-center justify-center w-16 h-16 rounded-full bg-green-100">
            <svg class="w-10 h-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>

        <!-- Heading -->
        <h2 class="text-2xl font-bold text-gray-900 mb-2">
            Thank you!
        </h2>

        <p class="text-gray-600 mb-6">
            Your booking is confirmed. A confirmation email will be sent to  
            <span class="font-semibold"><%= user ? user.email : '' %></span>.
        </p>

        <!-- Divider -->
        <div class="h-px bg-gray-200 mb-6"></div>

        <!-- Booking Details -->
        <div class="text-left mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Booking Details</h3>

            <p class="text-sm text-gray-700 mb-1"><strong>🏡 Home:</strong> <%= homeDetails.houseName %></p>
            <p class="text-sm text-gray-700 mb-1"><strong>📍 Location:</strong> <%= homeDetails.location %></p>
            <p class="text-sm text-gray-700"><strong>💰 Price per night:</strong> ₹<%= homeDetails.price %></p>
        </div>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-6">
            <a
            href="/bookings"
            class="bg-gradient-to-r from-red-500 to-orange-500 hover:from-red-600 hover:to-orange-600 text-white font-semibold px-6 py-3 rounded-lg shadow-md hover:shadow-lg transition active:scale-95 w-full sm:w-auto text-center"
            >
            View My Bookings
            </a>

            <a
            href="/"
            class="border border-gray-300 text-gray-800 font-medium px-6 py-3 rounded-lg hover:bg-gray-50 transition active:scale-95 w-full sm:w-auto text-center"
            >
            Back to Home
            </a>
        </div>

        </div>

  </main>
</body>
</html>
