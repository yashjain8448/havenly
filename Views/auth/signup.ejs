<%- include('../partials/head') %>
</head>

<body class="bg-gradient-to-br from-red-50 via-orange-50 to-yellow-50 min-h-screen">
  <%- include('../partials/nav') %>

  <main class="flex items-center justify-center px-4 py-8 min-h-[calc(100vh-100px)]">
    <div class="w-full max-w-md">
      <!-- Card Container -->
      <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">

        <!-- Header Section -->
        <div class="bg-gradient-to-r from-red-500 via-red-500 to-orange-500 px-8 py-12 text-center relative">
          <div class="absolute top-3 right-3 text-4xl opacity-20">🏠</div>
          <h1 class="text-3xl font-bold text-white mb-2">Join Us Today</h1>
          <p class="text-red-100 text-sm">Create your account and explore amazing spaces</p>
        </div>

        <!-- Form Container -->
        <div class="p-8 space-y-5">
          <form action="/signup" method="POST" class="space-y-5">

            <%- include('../partials/errors') %>
            
            <!-- Name Row -->
            <div class="grid grid-cols-2 gap-3">
              <div class="relative">
                <label class="text-xs font-semibold text-gray-700 block mb-1.5">First Name</label>
                <input id="firstName" type="text" name="firstName" placeholder="John"
                  class="w-full px-4 py-2.5 text-sm border-2 border-gray-200 rounded-lg 
                         focus:outline-none focus:border-red-500 focus:ring-0 bg-gray-50 hover:bg-white transition"
                  value="<%= oldInput && oldInput.firstName ? oldInput.firstName : '' %>" required>
              </div>

              <div class="relative">
                <label class="text-xs font-semibold text-gray-700 block mb-1.5">Last Name</label>
                <input id="lastName" type="text" name="lastName" placeholder="Doe"
                  class="w-full px-4 py-2.5 text-sm border-2 border-gray-200 rounded-lg 
                         focus:outline-none focus:border-red-500 focus:ring-0 bg-gray-50 hover:bg-white transition"
                  value="<%= oldInput && oldInput.lastName ? oldInput.lastName : '' %>" required>
              </div>
            </div>

            <!-- Email -->
            <div class="relative">
              <label class="text-xs font-semibold text-gray-700 block mb-1.5">Email Address</label>
              <input id="email" type="email" name="email" placeholder="you@example.com"
                class="w-full px-4 py-2.5 text-sm border-2 border-gray-200 rounded-lg 
                       focus:outline-none focus:border-red-500 focus:ring-0 bg-gray-50 hover:bg-white transition"
                value="<%= oldInput && oldInput.email ? oldInput.email : '' %>" required>
            </div>

            <!-- Passwords -->
            <div class="relative">
              <label class="text-xs font-semibold text-gray-700 block mb-1.5">Password</label>
              <input id="password" type="password" name="password" placeholder="••••••••"
                class="w-full px-4 py-2.5 text-sm border-2 border-gray-200 rounded-lg 
                       focus:outline-none focus:border-red-500 focus:ring-0 bg-gray-50 hover:bg-white transition"
                required>
            </div>

            <div class="relative">
              <label class="text-xs font-semibold text-gray-700 block mb-1.5">Confirm Password</label>
              <input id="confirmPassword" type="password" name="confirmPassword" placeholder="••••••••"
                class="w-full px-4 py-2.5 text-sm border-2 border-gray-200 rounded-lg 
                       focus:outline-none focus:border-red-500 focus:ring-0 bg-gray-50 hover:bg-white transition"
                required>
            </div>

            <!-- Roles -->
            <div class="pt-2">
              <label class="text-xs font-semibold text-gray-700 block mb-3">I'm joining as:</label>

              <div class="flex gap-6 items-center justify-center">
                <!-- Guest -->
                <label class="flex items-center gap-2 cursor-pointer group">
                  <input 
                    type="radio" 
                    name="userType" 
                    value="guest" 
                    class="sr-only peer"
                    <% if (oldInput && oldInput.userType === 'guest') { %>checked<% } %>
                  >
                  <div class="w-4 h-4 border-2 border-gray-300 rounded-full peer-checked:border-red-500 peer-checked:bg-red-50 flex items-center justify-center transition-all">
                    <div class="w-2 h-2 bg-red-500 rounded-full opacity-0 peer-checked:opacity-100"></div>
                  </div>
                  <span class="text-sm font-medium text-gray-700 group-hover:text-red-600 transition">👤 Guest</span>
                </label>

                <!-- Host -->
                <label class="flex items-center gap-2 cursor-pointer group">
                  <input 
                    type="radio" 
                    name="userType" 
                    value="host" 
                    class="sr-only peer"
                    <% if (oldInput && oldInput.userType === 'host') { %>checked<% } %>
                  >
                  <div class="w-4 h-4 border-2 border-gray-300 rounded-full peer-checked:border-red-500 peer-checked:bg-red-50 flex items-center justify-center transition-all">
                    <div class="w-2 h-2 bg-red-500 rounded-full opacity-0 peer-checked:opacity-100"></div>
                  </div>
                  <span class="text-sm font-medium text-gray-700 group-hover:text-red-600 transition">🏠 Host</span>
                </label>
              </div>
            </div>

            <!-- Terms -->
            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-lg border-2 border-gray-200 hover:border-red-300 hover:bg-red-50 transition-all">
              <input type="checkbox" name="terms" value="on" class="sr-only peer" required>

              <div class="w-5 h-5 border-2 border-gray-300 rounded flex items-center justify-center peer-checked:bg-red-500 peer-checked:border-red-500 transition-all flex-shrink-0">
                <svg class="w-3 h-3 text-white opacity-0 peer-checked:opacity-100" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>

              <span class="text-sm text-gray-700">
                I agree to the <span class="font-semibold text-red-600 hover:text-red-700">terms & conditions</span>
              </span>
            </label>

            <!-- Submit Button -->
            <button type="submit"
              class="w-full bg-gradient-to-r from-red-500 to-orange-500 hover:from-red-600 hover:to-orange-600 text-white font-bold py-3 rounded-lg text-base shadow-lg hover:shadow-xl transform transition-all duration-200 active:scale-95">
              Create Account
            </button>

          </form>
        </div>

        <!-- Footer -->
        <div class="bg-gray-50 px-8 py-5 border-t border-gray-100 text-center">
          <p class="text-sm text-gray-600">
            Already have an account?
            <a href="/login" class="font-semibold text-red-600 hover:text-red-700 hover:underline transition">Sign in here</a>
          </p>
        </div>

      </div>
    </div>
  </main>
</body>
</html>
